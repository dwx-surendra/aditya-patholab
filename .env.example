# EmailJS Configuration
# Get these from https://www.emailjs.com/ (free account)
# 1. Create an Email Service (Gmail) → copy Service ID
# 2. Create a Booking template     → copy Template ID
# 3. Create a Contact template     → copy Template ID
# 4. Account → API Keys            → copy Public Key

VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_BOOKING_TEMPLATE_ID
VITE_EMAILJS_CONTACT_TEMPLATE_ID=YOUR_CONTACT_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
